{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.musketeer": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [ "idle" ],
          "transitions": [
            { "walk": "query.is_riding ? query.property('udaw:mounted_moving') : query.is_moving" }
          ]
        },
        "walk": {
          "animations": [ "walk" ],
          "transitions": [
            { "idle": "query.is_riding ? !query.property('udaw:mounted_moving') : !query.is_moving" }
          ]
        }
      }
    }
  }
}
