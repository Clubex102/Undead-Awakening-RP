{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.swordman": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [ "idle" ],
          "transitions": [
            { "walk": "query.is_riding ? query.property('udaw:mounted_moving') : query.is_moving" },
            { "attack": "variable.attack_time > 0" }
          ]
        },
        "walk": {
          "animations": [ "walk" ],
          "transitions": [
            { "idle": "query.is_riding ? !query.property('udaw:mounted_moving') : !query.is_moving" },
            { "attack": "variable.attack_time > 0" }
          ]
        },
        "attack": {
          "animations": [ "attack" ],
          "transitions": [
            { "idle": "!variable.attack_time" }
          ]
        }
      }
    }
  }
}
