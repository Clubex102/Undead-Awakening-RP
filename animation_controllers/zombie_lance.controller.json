{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.zombie_lance": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        "idle"
                    ],
                    "transitions": [
                        { "attack": "variable.attack_time > 0" },
                        { "walk":   "query.modified_move_speed > 0.1" }
                    ],
                    "blend_via_shortest_path": true
                },
                "walk": {
                    "animations": [
                        "walk"
                    ],
                    "transitions": [
                        { "attack": "variable.attack_time > 0" },
                        { "idle":  "query.modified_move_speed <= 0.1" }
                    ],
                    "blend_via_shortest_path": true
                },
                "attack": {
                    "animations": [
                        "atack"
                    ],
                    "transitions": [
                        {
                            "walk": "query.modified_move_speed > 0.1 && query.all_animations_finished"
                        },
                        {
                            "idle": "query.modified_move_speed <= 0.1 && query.all_animations_finished"
                        }
                    ],
                    "blend_via_shortest_path": false
                }
            }
        }
    }
}
