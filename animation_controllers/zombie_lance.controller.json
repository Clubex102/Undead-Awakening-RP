{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.zombie_lance": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        { "attack": "variable.attack_time > 0" }
                    ]
                },
                "attack": {
                    "animations": [
                        "atack"
                    ],
                    "transitions": [
                        { "default": "!variable.attack_time" }
                    ]
                }
            }
        }
    }
}
