{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "udaw:zombie_fisher",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/fisher.png"
      },
      "geometry": {
        "default": "geometry.fisher"
      },
      "animations": {
        "walk": "animation.fisher.walk",
        "swim": "animation.fisher.swiming",
        "attack": "animation.fisher.fished",
        "look_at_target": "animation.common.look_at_target"
      },
      "scripts": {
        "animate": [
          {"walk": "query.is_moving && query.is_on_ground && !query.is_in_water"},
          {"swim": "query.is_in_water"},
          {"attack": "variable.attack_time > 0"},
          "look_at_target"
        ]
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "texture": "spawn_egg_zombie_fisher"
      }
    }
  }
}
