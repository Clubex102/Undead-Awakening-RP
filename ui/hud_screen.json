{
  "namespace": "hud",
  "infection_image": {
    "type": "image",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": ["112%", "112%"],
    "keep_ratio": false,
    "fill": true,
    "layer": 100,
    "$infection_state": "$actionbar_text",
    "$infection_texture|default": "textures/ui/lvl1",
    "$infection_match|default": "INFECTION_OFF",
    "texture": "$infection_texture",
    "visible": "($infection_state = $infection_match)"
  },
  "infection_overlay": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": ["100%", "100%"],
    "layer": 100,
    "controls": [
      { "inf_1@hud.infection_image": { "$infection_texture": "textures/ui/lvl1", "$infection_match": "INFECTION_LVL1" } },
      { "inf_2@hud.infection_image": { "$infection_texture": "textures/ui/lvl2", "$infection_match": "INFECTION_LVL2" } },
      { "inf_3@hud.infection_image": { "$infection_texture": "textures/ui/lvl3", "$infection_match": "INFECTION_LVL3" } },
      { "inf_4@hud.infection_image": { "$infection_texture": "textures/ui/lvl4", "$infection_match": "INFECTION_LVL4" } }
    ]
  },
  "infection_overlay_factory": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": ["100%", "100%"],
    "factory": {
      "name": "hud_actionbar_text_factory",
      "control_ids": {
        "hud_actionbar_text": "infection_overlay@hud.infection_overlay"
      }
    }
  },
  "hud_actionbar_text": {
    "$infection_actionbar": "$actionbar_text",
    "visible": "(not (($infection_actionbar = 'INFECTION_LVL1') or ($infection_actionbar = 'INFECTION_LVL2') or ($infection_actionbar = 'INFECTION_LVL3') or ($infection_actionbar = 'INFECTION_LVL4') or ($infection_actionbar = 'INFECTION_OFF')))"
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "infection_overlay_factory@hud.infection_overlay_factory": {}
        }
      }
    ]
  }
}
