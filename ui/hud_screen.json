{
  "namespace": "hud",
  "udaw_inf_image": {
    "type": "image",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": ["112%", "112%"],
    "keep_ratio": false,
    "fill": true,
    "layer": 100,
    "$inf_texture|default": "textures/ui/lvl1",
    "$inf_min|default": 0,
    "$inf_max|default": 26,
    "texture": "$inf_texture",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "((((#hud_title_text_string - 'UDAW_INF_') + 0) > $inf_min) and (((#hud_title_text_string - 'UDAW_INF_') + 0) < $inf_max))",
        "target_property_name": "#visible"
      }
    ]
  },
  "udaw_inf_overlay": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": ["100%", "100%"],
    "controls": [
      { "inf_1@hud.udaw_inf_image": { "$inf_texture": "textures/ui/lvl1", "$inf_min": 0, "$inf_max": 26 } },
      { "inf_2@hud.udaw_inf_image": { "$inf_texture": "textures/ui/lvl2", "$inf_min": 25, "$inf_max": 51 } },
      { "inf_3@hud.udaw_inf_image": { "$inf_texture": "textures/ui/lvl3", "$inf_min": 50, "$inf_max": 76 } },
      { "inf_4@hud.udaw_inf_image": { "$inf_texture": "textures/ui/lvl4", "$inf_min": 75, "$inf_max": 101 } }
    ]
  },
  "hud_title_text": {
    "bindings": [
      {
        "binding_type": "global",
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((#hud_title_text_string - 'UDAW_INF_') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },
  "hud_subtitle_text": {
    "bindings": [
      {
        "binding_type": "global",
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((#hud_title_text_string - 'UDAW_INF_') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "udaw_inf_overlay@hud.udaw_inf_overlay": {}
        }
      }
    ]
  }
}
